# Optional: enables the AI Coach (Gemini). Everything else works without it.
GEMINI_API_KEY=""
# Optional: override the Gemini model used by the coach.
GEMINI_MODEL="gemini-3.5-flash"
# Port for the Node server (default 3000).
PORT=3000
# Optional: enables "Sign in with Google". Create an OAuth 2.0 Client ID (type: Web application)
# in Google Cloud Console and add your site's origin(s) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=""
# Where accounts and sessions are stored (JSON file). Use a persistent volume in production.
DATA_DIR="./data"
